<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:layout_marginHorizontal="0dp"
    android:gravity="center_horizontal" android:orientation="vertical">
    <TextView android:id="@+id/day_label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:includeFontPadding="false" android:maxLines="1"
        android:ellipsize="end" android:textSize="8sp" android:textStyle="bold"
        android:textColor="#D9EEFA" />
    <ImageView android:id="@+id/day_icon" android:layout_width="match_parent"
        android:layout_height="13dp" android:scaleType="centerInside"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/day_temp" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:includeFontPadding="false" android:maxLines="1"
        android:ellipsize="end" android:textSize="8sp" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/day_rain" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:includeFontPadding="false" android:maxLines="1"
        android:ellipsize="end" android:textSize="9sp" android:textStyle="bold"
        android:textColor="#7EE5DF" />
    <TextView android:id="@+id/day_mm" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:includeFontPadding="false" android:maxLines="1"
        android:ellipsize="end" android:textSize="9sp" android:textStyle="bold"
        android:textColor="#FFFFFF" />
</LinearLayout>
