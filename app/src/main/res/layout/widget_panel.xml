<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/widget_card" android:layout_width="match_parent"
        android:layout_height="match_parent" android:clipToOutline="true"
        android:background="@drawable/widget_outline">
        <ImageView android:id="@+id/widget_background" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitXY"
            android:importantForAccessibility="no" />
        <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical"
            android:paddingHorizontal="6dp" android:paddingTop="3dp" android:paddingBottom="3dp">
            <!-- LIVE stays upper left; city and settings are at far right of the same row. -->
            <LinearLayout android:id="@+id/widget_now" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:baselineAligned="false">
                <TextView android:id="@+id/widget_live_label" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:paddingEnd="4dp" android:text="LIVE" android:textStyle="bold"
                    android:textSize="8sp" />
                <TextView android:id="@+id/widget_temp" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:maxLines="1" android:text="21°" android:textSize="24sp"
                    android:textStyle="bold" />
                <ImageView android:id="@+id/widget_icon" android:layout_width="41dp"
                    android:layout_height="41dp" android:scaleType="centerInside"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/widget_condition" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:ellipsize="end" android:maxLines="1" android:includeFontPadding="false"
                    android:textSize="8sp" />
                <LinearLayout android:id="@+id/widget_header" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:gravity="center_vertical|end"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/widget_city" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:ellipsize="end"
                        android:maxWidth="84dp" android:maxLines="1"
                        android:includeFontPadding="false" android:textSize="9sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/widget_settings" android:layout_width="21dp"
                        android:layout_height="22dp" android:contentDescription="@string/widget_customize"
                        android:gravity="end|center_vertical" android:includeFontPadding="false"
                        android:text="@string/widget_gear" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <!-- The Today row contains forecast HOURS (not a daily total). -->
            <LinearLayout android:id="@+id/widget_today_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:baselineAligned="false"
                android:layout_marginTop="1dp">
                <TextView android:id="@+id/widget_today_label" android:layout_width="39dp"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:gravity="start|center_vertical" android:text="TODAY"
                    android:textSize="8sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/widget_hours" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:baselineAligned="false" />
            </LinearLayout>
            <!-- All seven days, with icon + probability + mm, stay in their own third row. -->
            <LinearLayout android:id="@+id/widget_week_section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:baselineAligned="false"
                android:layout_marginTop="2dp">
                <TextView android:id="@+id/widget_week_label" android:layout_width="39dp"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:gravity="start|center_vertical" android:text="7 DAYS"
                    android:textSize="8sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/widget_days" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:baselineAligned="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_rain_panel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginTop="3dp" android:paddingHorizontal="5dp"
                android:paddingVertical="1dp" android:background="@drawable/bg_alert"
                android:visibility="gone">
                <TextView android:id="@+id/widget_alert_head" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:ellipsize="end" android:maxLines="1" android:textStyle="bold"
                    android:textSize="12sp" />
                <TextView android:id="@+id/widget_alert_sub" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:ellipsize="end" android:maxLines="1" android:textSize="8sp" />
            </LinearLayout>
            <TextView android:id="@+id/widget_message" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:includeFontPadding="false"
                android:maxLines="2" android:textSize="11sp" android:visibility="gone" />
            <TextView android:id="@+id/widget_footer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:includeFontPadding="false"
                android:maxLines="1" android:ellipsize="end" android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
