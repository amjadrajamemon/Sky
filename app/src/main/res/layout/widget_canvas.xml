<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="SkyCast live weather, today's rain and seven-day forecast"
        android:importantForAccessibility="yes"
        android:scaleType="fitXY" />
    <TextView
        android:id="@+id/widget_settings"
        android:layout_width="34dp"
        android:layout_height="28dp"
        android:layout_gravity="top|right"
        android:gravity="center"
        android:contentDescription="Customize SkyCast widget"
        android:text="⚙"
        android:textSize="17sp" />
</FrameLayout>
